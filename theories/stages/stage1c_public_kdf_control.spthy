theory MLS_RatchetTree_Stage1c_PublicKDFControl

/*
  Artifact stage provenance:
  Historical public-KDF control paired with stage1. Apart from the theory
  name/comment, the security-relevant change from stage1 is that node_sk/1
  is public rather than [private]. This is the control that produced the
  10-step L1 counterexample.
*/
/*
  Fix A + Fix B applied to Step-1 model:
    A) node_sk/1 is [private] so the adversary cannot compute it directly.
    B) Well-formedness fixes:
       - Bob_KP / Charlie_KP: single persistent-only fact (no linear stage).
       - S2_Bob_joins / S4_Charlie_joins: explicitly adec() and then decompose,
         so joiner / ps_x / ps_w are derivable from premises.

  This is the "diagnostic" version to check whether the 10-step attack
  found on the previous model is caused solely by the node_sk publication
  bug, WITHOUT introducing any KeyPackage authentication (ValidKP).
  If L1 becomes verified here, the attack was a modelling bug.
  If L1 remains falsified, the next candidate is KeyPackage substitution
  and adopting ValidKP would then be justified.
*/

begin

builtins: asymmetric-encryption, hashing, signing

// -- A: node_sk is PRIVATE (no builtin adversary derivation) --
functions: node_sk/1, node_pk/1
// The equation is terminating/non-overlapping but not syntactically subterm-convergent.
// Mark it convergent explicitly to suppress the corresponding well-formedness warning.
equations [convergent]: node_pk(ps) = pk(node_sk(ps))

// ============================================================
// Long-term identities and AS
// ============================================================

rule AS_Setup:
    [ Fr(~sk_as) ]
  --[ AS_Init(~sk_as) ]->
    [ !AS(~sk_as), Out(pk(~sk_as)) ]

rule Alice_LTK:
    [ Fr(~sk_alice) ]
  --[ AliceKey(~sk_alice) ]->
    [ !AliceLTK(~sk_alice), Out(pk(~sk_alice)) ]

// -- B: KeyPackage generation writes ONE persistent fact only.
rule Bob_generates_kp:
    [ Fr(~sk_b) ]
  --[ BobKPgen(~sk_b) ]->
    [ !Bob_KP(~sk_b, pk(~sk_b)),
      Out(<'kpg_b', pk(~sk_b)>) ]

rule Charlie_generates_kp:
    [ Fr(~sk_c) ]
  --[ CharlieKPgen(~sk_c) ]->
    [ !Charlie_KP(~sk_c, pk(~sk_c)),
      Out(<'kpg_c', pk(~sk_c)>) ]

// ============================================================
// Stage 1 : Alice creates the group
// ============================================================

rule S1_Alice_creates_group:
    [ !AliceLTK(sk_alice), Fr(~g), Fr(~ps_a), Fr(~epoch0) ]
  --[ S1_Create(~g, ~ps_a) ]->
    [ Alice_S1(~g, ~ps_a, h(~ps_a), ~epoch0, sk_alice),
      !Group(~g) ]

// ============================================================
// Stage 2 : Alice invites Bob
// ============================================================

rule S2_Alice_invites_Bob:
    let ps_x        = h(ps_a)
        joiner      = h(<epoch0, h(ps_x)>)
        welcome_body= <'Bob', ps_x, joiner>
        sig         = sign(welcome_body, sk_alice)
    in
    [ Alice_S1(g, ps_a, ps_x, epoch0, sk_alice),
      In(<'kpg_b', pk_b>) ]
  --[ S2_Invite(g, 'Bob'), Welcome(g, ps_x) ]->
    [ Alice_S2(g, ps_a, ps_x, epoch0, sk_alice),
      Out(<aenc(welcome_body, pk_b), sig>) ]

// -- B: Bob explicitly adec()s the Welcome so 'joiner' and 'ps_x'
//       are derivable from premises (Msg Derivation Check).
rule S2_Bob_joins:
    let welcome_body = adec(cipher, sk_b)
    in
    [ !Bob_KP(sk_b, pk_b),
      In(<cipher, sig>),
      In(pk_alice) ]
  --[ S2_Join('Bob', welcome_body),
      Eq(verify(sig, welcome_body, pk_alice), true) ]->
    [ Bob_S2(welcome_body) ]

// ============================================================
// Stage 3 : Bob updates his node
// ============================================================

rule S3_Bob_update:
    let ps_x_new = h(~ps_b)
        pk_a     = node_pk(ps_x_old)
    in
    [ Bob_S2(<'Bob', ps_x_old, joiner>), Fr(~ps_b) ]
  --[ S3_Update('Bob', ~ps_b, ps_x_new) ]->
    [ Bob_S3(~ps_b, ps_x_new),
      Out(<'commit_bob', aenc(ps_x_new, pk_a)>) ]

rule S3_Alice_receives_commit [no_derivcheck]:
    let pk_a = node_pk(ps_x_old)
    in
    [ Alice_S2(g, ps_a, ps_x_old, epoch0, sk_alice),
      In(<'commit_bob', aenc(ps_x_new, pk_a)>) ]
  --[ S3_Alice_sync(g, ps_x_new) ]->
    [ Alice_S3(g, ps_x_new, sk_alice) ]

// ============================================================
// Stage 4 : Alice invites Charlie
// ============================================================

rule S4_Alice_invites_Charlie:
    let ps_w        = h(ps_x_new)
        joiner      = h(<'ep3', ps_w>)
        welcome_body= <'Charlie', ps_w, joiner>
        sig         = sign(welcome_body, sk_alice)
    in
    [ Alice_S3(g, ps_x_new, sk_alice),
      In(<'kpg_c', pk_c>) ]
  --[ S4_Invite(g, 'Charlie'), Welcome_W(g, ps_w) ]->
    [ Alice_S4(g, ps_w),
      Out(<aenc(welcome_body, pk_c), sig>) ]

rule S4_Charlie_joins:
    let welcome_body = adec(cipher, sk_c)
    in
    [ !Charlie_KP(sk_c, pk_c),
      In(<cipher, sig>),
      In(pk_alice) ]
  --[ S4_Join('Charlie', welcome_body),
      Eq(verify(sig, welcome_body, pk_alice), true) ]->
    [ Charlie_S4(welcome_body) ]

rule S4_Bob_syncs:
    let ps_w = h(ps_x_new) in
    [ Bob_S3(ps_b, ps_x_new) ]
  --[ S4_Bob_syncW(ps_w) ]->
    [ Bob_S4(ps_w) ]

// ============================================================
// Stage 5 : Charlie updates node W
// ============================================================

rule S5_Charlie_update:
    let ps_w_new = h(~ps_c)
        pk_w_old = node_pk(ps_w_old)
    in
    [ Charlie_S4(<'Charlie', ps_w_old, joiner>), Fr(~ps_c) ]
  --[ S5_Update('Charlie', ~ps_c, ps_w_new) ]->
    [ Charlie_S5(ps_w_new),
      Out(<'commit_charlie', aenc(ps_w_new, pk_w_old)>) ]

rule S5_Alice_sync [no_derivcheck]:
    let pk_w_old = node_pk(ps_w_old) in
    [ Alice_S4(g, ps_w_old),
      In(<'commit_charlie', aenc(ps_w_new, pk_w_old)>) ]
  --[ S5_Alice_syncW(g, ps_w_new) ]->
    [ Alice_S5(g, ps_w_new) ]

rule S5_Bob_sync [no_derivcheck]:
    let pk_w_old = node_pk(ps_w_old) in
    [ Bob_S4(ps_w_old),
      In(<'commit_charlie', aenc(ps_w_new, pk_w_old)>) ]
  --[ S5_Bob_syncW(ps_w_new) ]->
    [ Bob_S5(ps_w_new) ]

// ============================================================
// Stage 6 : Charlie sends the secret MESSAGE
// ============================================================

rule S6_Charlie_sends:
    let pk_w = node_pk(ps_w) in
    [ Charlie_S5(ps_w), Fr(~msg) ]
  --[ S6_Send('Charlie', ~msg), Secret_MSG(~msg) ]->
    [ Out(aenc(~msg, pk_w)),
      !SentMsg(~msg) ]

rule S6_Alice_recv [no_derivcheck]:
    let pk_w = node_pk(ps_w) in
    [ Alice_S5(g, ps_w), In(aenc(m, pk_w)) ]
  --[ S6_Recv('Alice', m) ]->
    [ ]

rule S6_Bob_recv [no_derivcheck]:
    let pk_w = node_pk(ps_w) in
    [ Bob_S5(ps_w), In(aenc(m, pk_w)) ]
  --[ S6_Recv('Bob', m) ]->
    [ ]

// ============================================================
restriction eq_check:
    "All x y #i. Eq(x,y) @ i ==> x = y"

// ============================================================
// Sanity & Security lemmas (same set as before)
// ============================================================

lemma exec_normal_flow_alice_recv: exists-trace
    " Ex m #s #ra.
        S6_Send('Charlie', m) @ s
      & S6_Recv('Alice', m) @ ra
      & #s < #ra "

lemma exec_normal_flow_bob_recv: exists-trace
    " Ex m #s #rb.
        S6_Send('Charlie', m) @ s
      & S6_Recv('Bob', m) @ rb
      & #s < #rb "

lemma L1_baseline_secrecy:
    " All m #s.
        Secret_MSG(m) @ s
      ==> not (Ex #j. K(m) @ j) "

end
